# CamGuard server env. Copy to .env.local (gitignored) and adjust.
# None of these are NEXT_PUBLIC_*, so they stay server-side only.

# TideCloak dev server + realm (defaults match init/tcinit.sh).
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=nextjs-test

# Master-realm admin used ONLY to PROPOSE governed writes (file the role-grant
# change-request). It cannot approve on a board member's behalf — IGA credits an
# approval to whoever signs in the browser. Same creds tcinit.sh uses.
TC_ADMIN_USER=admin
TC_ADMIN_PASSWORD=password

# Optional production path: a confidential service-account client in the app
# realm with realm-management roles (manage-users). If BOTH are set, the server
# uses client_credentials instead of the master password above.
# TC_BACKEND_CLIENT_ID=camguard-backend
# TC_BACKEND_CLIENT_SECRET=change-me

# Clip cipher key — 32 bytes, base64. Seals the synthetic clips at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a deterministic DEV-ONLY key is derived (insecure; fine for the demo).
# CLIP_MASTER_KEY_B64=
